# Copie este arquivo para .env apenas como referência local.
# O Spring Boot NÃO carrega .env automaticamente.
# Exporte as variáveis no terminal ou configure-as no Cursor / IDE.

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-flash-latest

# xAI Grok (API compatível com OpenAI)
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.7

# Mistral
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_MODEL=mistral-small-latest

# DeepSeek (API compatível com OpenAI)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Perplexity (API compatível com OpenAI)
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai/v1
PERPLEXITY_MODEL=perplexity/sonar

# Qwen via endpoint compatível com OpenAI (ex.: DashScope)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Meta Llama API (OpenAI-compatible)
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.meta.ai/v1
LLAMA_MODEL=muse-spark-1.3
